# ==============================================================================
# AGOS IoT Flood Monitoring — Environment Configuration Example (.env.example)
# Tuned for Raspberry Pi Zero 2 W / Pi 3 / Pi 4 Edge Deployment
# ==============================================================================

# ==========================================
# 1. BACKEND & WEBSOCKET SERVER ENDPOINTS
# ==========================================
# Cloud or local backend REST endpoint for sensor readings
# Example Railway: https://agos-backend-production-e252.up.railway.app/api/v1/sensor-readings/record
SERVER_URL=https://agos-backend-production-e252.up.railway.app/api/v1/sensor-readings/record

# WebSocket server URL for real-time camera frame streaming
# Example: wss://agos-backend-production-e252.up.railway.app/ws/rpi?camera_device_id=1&location_id=1
WEBSOCKET_SERVER_URL=wss://agos-backend-production-e252.up.railway.app/ws/rpi?camera_device_id=1&location_id=1

# Secret API key for authenticating sensor telemetry ingestion
IOT_API_KEY=your_api_key_here

# Identifiers matching the backend device registry
SENSOR_DEVICE_ID=1
CAMERA_DEVICE_ID=1
LOCATION_ID=1

# ==========================================
# 2. TIMING & THROUGHPUT (INTERVALS IN SECONDS)
# ==========================================
# SENSOR_INTERVAL: Seconds between ultrasonic reads and server POSTs (60.0 = 1 read/min)
SENSOR_INTERVAL=60.0

# CAMERA_INTERVAL: Seconds between camera captures (10.0 = 1 image every 10 seconds)
# Note: Set to 0.1 for 10 FPS, or 10.0 for 1 frame every 10 seconds
CAMERA_INTERVAL=10.0

# ==========================================
# 3. TRANSMISSION & FEATURE TOGGLES
# ==========================================
# Disable Cloudinary to save bandwidth & power when WebSocket is active
ENABLE_CLOUDINARY_UPLOAD=false
ENABLE_WEBSOCKET_SEND=true
WS_SEND_METADATA_FIRST=false
SENSOR_POST_ENABLED=true

# Development / Mocking flags
MOCK_MODE=false
USE_FSWEBCAM=false
USE_TEST_IMAGES=false
TEST_IMAGES_DIR=test_images
USE_TRAINING_CAPTURES=false
TRAINING_CAPTURES_DIR=training_captures
USE_TRAINING_RAINING=false
TRAINING_RAINING_DIR=training_raining

# ==========================================
# 4. WEBSOCKET KEEPALIVE & TIMEOUTS
# ==========================================
# Set WS_PING_INTERVAL=0 to disable client heartbeat pings
WS_PING_INTERVAL=20
WS_PING_TIMEOUT=20
WS_CLOSE_TIMEOUT=10

# ==========================================
# 5. RISK INDICATOR LEDS & FUSION ENGINE
# ==========================================
# BCM Pin mapping for tri-color status indicator (State-based naming)
RISK_LED_CRITICAL_PIN=14
RISK_LED_WARNING_PIN=18
RISK_LED_SAFE_PIN=15

# Fusion & Decision Engine API endpoint (polls combined risk score)
RISK_SCORE_API_URL=https://agos-backend-production-e252.up.railway.app/api/v1/iot/risk-score?location_id=1
RISK_SCORE_POLL_INTERVAL=5.0

# Water-level fallback thresholds (used if API is unreachable)
# Distance in cm: Lower distance = higher water level = greater risk
# >= SAFE = safe (green), >= WARNING = warning (yellow), < WARNING = critical (red)
RISK_FALLBACK_SAFE_ABOVE_CM=50.0
RISK_FALLBACK_WARNING_ABOVE_CM=26.0

# ==========================================
# 6. SENSOR HARDWARE & STATISTICAL FILTERING
# ==========================================
SENSOR_TRIG_PIN=23
SENSOR_ECHO_PIN=24

# Ultrasonic burst sampling (median of accepted samples is used)
SENSOR_TIMEOUT_S=0.3
SENSOR_BURST_SAMPLES=7
SENSOR_BURST_MIN_VALID=3
SENSOR_BURST_SAMPLE_DELAY_S=0.06
# Optional temperature compensation (Celsius). Leave blank to disable.
SENSOR_TEMPERATURE_C=

# Telemetry filter (MAD-based modified Z-score outlier rejection + moving average)
SENSOR_FILTER_ENABLED=true
SENSOR_FILTER_WINDOW_SIZE=7
SENSOR_FILTER_MIN_VALID_SAMPLES=3
SENSOR_FILTER_MIN_CM=0.0
SENSOR_FILTER_MAX_CM=400.0
SENSOR_FILTER_MODZ_THRESHOLD=3.5
SENSOR_FILTER_ZERO_MAD_TOLERANCE_CM=1.0
SENSOR_FILTER_REBASELINE_OUTLIER_STREAK=3
SENSOR_FILTER_REBASELINE_SPREAD_MAX_CM=8.0

# ==========================================
# 7. CAMERA SENSOR (Picamera2 / libcamera)
# ==========================================
# Resolution: 1296x972 uses 2x2 binning on OV5647 for better sensitivity & lower CPU
CAMERA_WIDTH=1296
CAMERA_HEIGHT=972
CAMERA_NO_CROP=true
CAMERA_LOG_SCALERCROP=false

# Image quality & tuning
CAMERA_JPEG_QUALITY=85
CAMERA_SHARPNESS=2.5
CAMERA_CONTRAST=1.1
CAMERA_SATURATION=1.0

# Tuning files (located in /usr/share/libcamera/ipa/rpi/vc4/)
CAMERA_TUNING_FILE_DAY=ov5647.json
CAMERA_TUNING_FILE_NIGHT=ov5647_noir.json

# Auto-exposure compensation (EV)
CAMERA_EXPOSURE_VALUE_DAY=1.5
CAMERA_EXPOSURE_VALUE_NIGHT=0.0
CAMERA_EXPOSURE_TIME=0
CAMERA_ANALOGUE_GAIN=0
CAMERA_FRAME_DURATION_MAX=500000

# ==========================================
# 8. NIGHT VISION & IR-CUT FILTER CONTROL
# ==========================================
IR_CUT_PIN=17
# IR_CUT_MODE: auto | day | night
IR_CUT_MODE=day
IR_CUT_DAY_START_HOUR=6
IR_CUT_NIGHT_START_HOUR=18
IR_CUT_MIN_SWITCH_INTERVAL_S=30
IR_CUT_DAY_HIGH=true
IR_CUT_TIMEZONE=Asia/Manila

# Software CLAHE night enhancement (keep false to minimize CPU load on Pi Zero)
IMAGE_CLAHE_NIGHT_ENABLED=false

# Frame quality gate (keep false to minimize CPU unless active rejection needed)
FRAME_QUALITY_CHECK_ENABLED=false
FRAME_QUALITY_MIN_BRIGHTNESS=45.0
FRAME_QUALITY_MAX_BRIGHTNESS=210.0
FRAME_QUALITY_MIN_CONTRAST_STDDEV=25.0
FRAME_QUALITY_MIN_LAPLACIAN_VAR=100.0
FRAME_QUALITY_RESIZE_WIDTH=320
ENV_SENSE_DARKNESS_THRESHOLD=15.0

# ==========================================
# 9. REGION OF INTEREST (ROI) CROP
# ==========================================
# Set IMAGE_CROP_ENABLED=true to crop water marker area
IMAGE_CROP_ENABLED=true
# Crop coordinates (X, Y, Width, Height) based on 2592x1944
IMAGE_CROP_X=260
IMAGE_CROP_Y=0
IMAGE_CROP_WIDTH=770
IMAGE_CROP_HEIGHT=680

# ==========================================
# 10. CLOUDINARY BACKUP (OPTIONAL)
# ==========================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name